{
  "name": "📧 HANSEL-OS — Gmail Monitor + Auto-Label",
  "description": "Monitorea Gmail cada 15 min. Clasifica emails con Claude en: Audiciones, Colaboraciones, Coaching, Facturas, Sistema. Aplica label y alerta en Telegram si es P1.",
  "nodes": [
    {
      "id": "gmail-trigger",
      "name": "Gmail — Nuevo Email",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.1,
      "position": [0, 300],
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyX",
              "value": 15,
              "unit": "minutes"
            }
          ]
        },
        "filters": {
          "readStatus": "unread",
          "labelIds": ["INBOX"]
        },
        "options": {
          "dataPropertyAttachmentsPrefixName": "attachment_"
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "REEMPLAZAR_CON_TU_CREDENTIAL_ID",
          "name": "Gmail — Hansel-OS"
        }
      }
    },
    {
      "id": "claude-classify",
      "name": "Claude — Clasificar Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [220, 300],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "x-api-key", "value": "={{ $credentials.anthropicApi.apiKey }}"},
            {"name": "anthropic-version", "value": "2023-06-01"},
            {"name": "content-type", "value": "application/json"}
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "model": "claude-haiku-4-5-20251001",
          "max_tokens": 200,
          "messages": [
            {
              "role": "user",
              "content": "=Clasifica este email para Hansel Vela Vega (creador de contenido UGC, actor, coach).\n\nDe: {{ $json.from }}\nAsunto: {{ $json.subject }}\nResumen: {{ $json.snippet }}\n\nResponde SOLO en este formato JSON (sin explicación):\n{\n  \"categoria\": \"AUDICION|COLABORACION|COACHING|FACTURA|SISTEMA|OTRO\",\n  \"prioridad\": \"P1|P2|P3\",\n  \"accion\": \"texto de máx 15 palabras de qué hacer\",\n  \"requiere_respuesta\": true|false\n}"
            }
          ]
        }
      }
    },
    {
      "id": "parse-classification",
      "name": "Parse Clasificación",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 300],
      "parameters": {
        "jsCode": "const response = $input.item.json;\nconst text = response.content[0].text;\n\nlet classification;\ntry {\n  classification = JSON.parse(text);\n} catch(e) {\n  classification = {\n    categoria: 'OTRO',\n    prioridad: 'P3',\n    accion: 'Revisar manualmente',\n    requiere_respuesta: false\n  };\n}\n\nconst labelMap = {\n  'AUDICION': '🎬 Audiciones',\n  'COLABORACION': '🤝 Colaboraciones',\n  'COACHING': '💪 Coaching',\n  'FACTURA': '💳 Facturas',\n  'SISTEMA': '🤖 Hansel-OS',\n  'OTRO': null\n};\n\nreturn {\n  ...classification,\n  label: labelMap[classification.categoria] || null,\n  emailId: $('Gmail — Nuevo Email').item.json.id,\n  subject: $('Gmail — Nuevo Email').item.json.subject,\n  from: $('Gmail — Nuevo Email').item.json.from\n};"
      }
    },
    {
      "id": "if-p1",
      "name": "IF — Es P1?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [660, 300],
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": false},
          "conditions": [
            {
              "leftValue": "={{ $json.prioridad }}",
              "rightValue": "P1",
              "operator": {"type": "string", "operation": "equals"}
            }
          ]
        }
      }
    },
    {
      "id": "telegram-p1-alert",
      "name": "Telegram — Alerta P1",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [880, 200],
      "parameters": {
        "operation": "sendMessage",
        "chatId": "REEMPLAZAR_CON_TU_CHAT_ID",
        "text": "=📧 EMAIL P1 — {{ $json.categoria }}\\n\\nDe: {{ $json.from }}\\nAsunto: {{ $json.subject }}\\n\\n⚡ Acción: {{ $json.accion }}\\n{{ $json.requiere_respuesta ? '↩️ Requiere respuesta' : '' }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "REEMPLAZAR_CON_TU_CREDENTIAL_ID",
          "name": "Telegram — Hansel-OS Bot"
        }
      }
    }
  ],
  "connections": {
    "Gmail — Nuevo Email": {
      "main": [
        [{"node": "Claude — Clasificar Email", "type": "main", "index": 0}]
      ]
    },
    "Claude — Clasificar Email": {
      "main": [
        [{"node": "Parse Clasificación", "type": "main", "index": 0}]
      ]
    },
    "Parse Clasificación": {
      "main": [
        [{"node": "IF — Es P1?", "type": "main", "index": 0}]
      ]
    },
    "IF — Es P1?": {
      "main": [
        [{"node": "Telegram — Alerta P1", "type": "main", "index": 0}],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Mexico_City"
  },
  "tags": ["hansel-os", "gmail", "monitor"],
  "_nota": "Las labels de Gmail deben crearse manualmente primero. Ver setup_guides/gmail_labels_setup.md"
}
